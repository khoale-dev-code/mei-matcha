"use client";

import Link from "next/link";
import {
  AnimatePresence,
  motion,
  useMotionValueEvent,
  useScroll,
  useTransform,
} from "framer-motion";
import { useRef, useState } from "react";

type RitualSlide = {
  id: string;
  eyebrow: string;
  title: string;
  accent: string;
  copy: string;
  note: string;
};

const RITUAL_SLIDES: RitualSlide[] = [
  {
    id: "01",
    eyebrow: "Select the profile",
    title: "Choose",
    accent: "floral · nutty · umami",
    copy:
      "Chọn profile hợp khẩu vị — nhẹ hoa cỏ, béo bùi hay đậm umami — để bắt đầu đúng nhịp với chén matcha của bạn.",
    note: "Start with what feels easy to love.",
  },
  {
    id: "02",
    eyebrow: "Whisk by hand",
    title: "Whisk",
    accent: "chasen · texture · foam",
    copy:
      "Mỗi chén được đánh bằng chasen để bột trà hòa mịn, lớp bọt lên đẹp và hậu vị mở ra tròn hơn, mềm hơn.",
    note: "Texture first, then aroma, then depth.",
  },
  {
    id: "03",
    eyebrow: "Stay with the cup",
    title: "Slow",
    accent: "linger · soften · notice",
    copy:
      "Dành một nhịp chậm để nhìn màu xanh, cảm texture mịn và để vị trà đi từ êm dịu sang hậu ngọt rõ ràng hơn.",
    note: "The quiet moment is part of the drink.",
  },
];

function getStepIndex(progress: number) {
  if (progress < 0.34) return 0;
  if (progress < 0.68) return 1;
  return 2;
}

function VisitIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      className="size-4"
      fill="none"
      stroke="currentColor"
      strokeWidth="1.8"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7" />
      <path d="M9 7h8v8" />
    </svg>
  );
}

function StoryIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      className="size-4"
      fill="none"
      stroke="currentColor"
      strokeWidth="1.8"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      <path d="M5 6.5A2.5 2.5 0 0 1 7.5 4H19v15H7.5A2.5 2.5 0 0 0 5 21.5v-15Z" />
      <path d="M5 6.5v15" />
      <path d="M9 8h6" />
      <path d="M9 12h6" />
    </svg>
  );
}


function MobileSlowDownScene() {
  const sectionRef = useRef<HTMLElement | null>(null);
  const [activeStep, setActiveStep] = useState(0);

  const { scrollYProgress } = useScroll({
    target: sectionRef,
    offset: ["start start", "end end"],
  });

  useMotionValueEvent(scrollYProgress, "change", (latest) => {
    const nextStep = getStepIndex(latest);
    setActiveStep((current) => (current === nextStep ? current : nextStep));
  });

  const headingY = useTransform(scrollYProgress, [0.02, 0.18], [26, 0]);
  const headingOpacity = useTransform(
    scrollYProgress,
    [0.01, 0.12],
    [0.45, 1],
  );
  const cardY = useTransform(scrollYProgress, [0.05, 0.22], [26, 0]);
  const cardOpacity = useTransform(scrollYProgress, [0.04, 0.16], [0.4, 1]);
  const progressScale = useTransform(scrollYProgress, [0.02, 0.96], [0, 1]);

  const activeSlide = RITUAL_SLIDES[activeStep];

  return (
    <>
      <section
        ref={sectionRef}
        className="relative h-[300svh] bg-[var(--mie-washi)] text-[var(--mie-ink)] motion-reduce:hidden lg:hidden"
        aria-labelledby="slow-down-mobile-heading"
      >
        <div className="sticky top-0 flex h-[100svh] min-h-[32rem] flex-col overflow-hidden px-4 pb-3 pt-[4.75rem] sm:px-6 sm:pt-[5.25rem]">
          <div className="pointer-events-none absolute inset-0">
            <div className="absolute -left-20 top-16 size-56 rounded-full bg-[var(--mie-matcha)]/18 blur-3xl" />
            <div className="absolute -right-24 bottom-10 size-64 rounded-full bg-[var(--mie-matcha-deep)]/7 blur-3xl" />
          </div>

          <div className="relative flex shrink-0 items-center justify-between gap-3 border-b border-[var(--mie-ink)]/10 pb-2.5">
            <div className="flex min-w-0 items-center gap-2.5">
              <span className="grid size-8 shrink-0 place-items-center rounded-full border border-[var(--mie-ink)]/12 bg-white/30 text-[8px] font-extrabold tracking-[0.12em]">
                01
              </span>
              <div className="min-w-0">
                <p className="truncate text-[8px] font-bold uppercase tracking-[0.22em] text-[var(--mie-moss)]/68">
                  MIE philosophy
                </p>
                <p className="mt-0.5 truncate text-[10px] text-[var(--mie-ink)]/48">
                  Scroll để đổi bước thưởng trà
                </p>
              </div>
            </div>

            <span className="shrink-0 rounded-full border border-[var(--mie-matcha-deep)]/16 bg-[var(--mie-matcha)]/14 px-2.5 py-1.5 text-[8px] font-extrabold tracking-[0.12em] text-[var(--mie-matcha-deep)]">
              {activeSlide.id} / 03
            </span>
          </div>

          <motion.div
            className="mie-slide-motion relative shrink-0 pt-3"
            style={{ y: headingY, opacity: headingOpacity }}
          >
            <p className="text-[8px] font-bold uppercase tracking-[0.22em] text-[var(--mie-moss)]/52">
              Japanese tea · Tây Ninh
            </p>
            <h2
              id="slow-down-mobile-heading"
              className="mt-2 max-w-[7.2ch] font-serif text-[clamp(2.55rem,13vw,3.8rem)] leading-[0.86] tracking-[-0.055em]"
            >
              Slow down.
              <span className="mt-1 block">
                with{" "}
                <em className="italic text-[var(--mie-matcha-deep)]">
                  MIE.
                </em>
              </span>
            </h2>
          </motion.div>

          <motion.div
            className="mie-slide-motion relative mt-3 min-h-0 flex-1"
            style={{ y: cardY, opacity: cardOpacity }}
          >
            <div className="absolute inset-x-0 top-0 h-px overflow-hidden bg-[var(--mie-ink)]/8">
              <motion.div
                className="mie-slide-motion h-full origin-left bg-[var(--mie-matcha-deep)]"
                style={{ scaleX: progressScale }}
              />
            </div>

            <div className="flex h-full min-h-0 items-center pt-2">
              <div className="w-full overflow-hidden rounded-[1.35rem] border border-[var(--mie-ink)]/10 bg-[var(--mie-ivory)]/82 p-4 shadow-[0_18px_46px_rgba(32,43,28,0.08)] backdrop-blur-sm">
                <AnimatePresence mode="wait">
                  <motion.div
                    key={activeSlide.id}
                    initial={{ opacity: 0, y: 34 }}
                    animate={{
                      opacity: 1,
                      y: 0,
                      transition: {
                        duration: 0.42,
                        ease: [0.22, 1, 0.36, 1],
                      },
                    }}
                    exit={{
                      opacity: 0,
                      y: -24,
                      transition: { duration: 0.2, ease: "easeOut" },
                    }}
                    className="mie-slide-motion"
                  >
                    <div className="flex items-start justify-between gap-4">
                      <div>
                        <p className="text-[8px] font-bold uppercase tracking-[0.18em] text-[var(--mie-moss)]/48">
                          {activeSlide.eyebrow}
                        </p>
                        <div className="mt-2 flex items-end gap-3">
                          <span className="font-serif text-[3.25rem] leading-none tracking-[-0.06em] text-[var(--mie-ink)]">
                            {activeSlide.id}
                          </span>
                          <div className="pb-1">
                            <h3 className="font-serif text-[1.75rem] leading-none tracking-[-0.04em]">
                              {activeSlide.title}
                            </h3>
                            <p className="mt-1.5 text-[8px] font-bold uppercase tracking-[0.15em] text-[var(--mie-matcha-deep)]">
                              {activeSlide.accent}
                            </p>
                          </div>
                        </div>
                      </div>

                      <div className="grid gap-1 pt-1">
                        {RITUAL_SLIDES.map((slide, index) => (
                          <span
                            key={slide.id}
                            className={[
                              "h-1 rounded-full transition-all duration-300",
                              index === activeStep
                                ? "w-7 bg-[var(--mie-matcha-deep)]"
                                : "w-3 bg-[var(--mie-ink)]/12",
                            ].join(" ")}
                          />
                        ))}
                      </div>
                    </div>

                    <p className="mt-3 text-[0.86rem] leading-6 text-[var(--mie-ink)]/68">
                      {activeSlide.copy}
                    </p>

                    <div className="mt-3 rounded-[0.95rem] border border-[var(--mie-ink)]/8 bg-[var(--mie-washi)]/78 px-3.5 py-2.5">
                      <p className="text-[7px] font-bold uppercase tracking-[0.17em] text-[var(--mie-moss)]/40">
                        Why this matters
                      </p>
                      <p className="mt-1 font-serif text-[0.98rem] italic leading-5 text-[var(--mie-matcha-deep)]">
                        {activeSlide.note}
                      </p>
                    </div>
                  </motion.div>
                </AnimatePresence>
              </div>
            </div>
          </motion.div>

          <div className="relative mt-3 grid shrink-0 grid-cols-2 gap-2.5">
            <Link
              href="/visit"
              className="group inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-[#29452c] bg-[#17351b] px-3 !text-[#fffaf0] shadow-[0_10px_24px_rgba(20,34,18,0.14)] active:scale-[0.98]"
            >
              <span className="grid size-6 place-items-center rounded-full border border-white/15 bg-white/10 text-[#fffaf0]">
                <VisitIcon />
              </span>
              <span className="text-[8px] font-extrabold uppercase tracking-[0.15em] text-[#fffaf0]">
                Visit MIE
              </span>
            </Link>

            <Link
              href="/about"
              className="group inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-[#172314]/14 bg-[#fffaf0] px-3 text-[#172314] shadow-[0_8px_18px_rgba(32,43,28,0.05)] active:scale-[0.98]"
            >
              <span className="grid size-6 place-items-center rounded-full border border-[#172314]/10 bg-[#edf0df]">
                <StoryIcon />
              </span>
              <span className="text-[8px] font-extrabold uppercase tracking-[0.15em]">
                Our story
              </span>
            </Link>
          </div>

          <div className="relative mt-2.5 flex shrink-0 items-center justify-between gap-3">
            <p className="text-[7px] font-bold uppercase tracking-[0.17em] text-[var(--mie-moss)]/38">
              Vertical scroll · presentation mode
            </p>
            <p className="text-right text-[8px] font-semibold uppercase tracking-[0.13em] text-[var(--mie-matcha-deep)]/68">
              {activeSlide.title}
            </p>
          </div>
        </div>
      </section>

      <section className="hidden bg-[var(--mie-washi)] px-4 py-16 text-[var(--mie-ink)] motion-reduce:block lg:hidden">
        <p className="text-[8px] font-bold uppercase tracking-[0.2em] text-[var(--mie-moss)]/56">
          MIE philosophy
        </p>
        <h2 className="mt-3 max-w-[8ch] font-serif text-5xl leading-[0.9] tracking-[-0.05em]">
          Slow down.
          <span className="block italic text-[var(--mie-matcha-deep)]">
            with MIE.
          </span>
        </h2>
        <div className="mt-8 grid gap-3">
          {RITUAL_SLIDES.map((slide) => (
            <article
              key={slide.id}
              className="rounded-[1.2rem] border border-[var(--mie-ink)]/10 bg-[var(--mie-ivory)]/80 p-4"
            >
              <p className="text-[8px] font-bold uppercase tracking-[0.16em] text-[var(--mie-matcha-deep)]">
                {slide.id} · {slide.title}
              </p>
              <p className="mt-2 text-sm leading-6 text-[var(--mie-ink)]/68">
                {slide.copy}
              </p>
            </article>
          ))}
        </div>
      </section>
    </>
  );
}

function DesktopSlowDownScene() {
  const sectionRef = useRef<HTMLElement | null>(null);
  const [activeStep, setActiveStep] = useState(0);

  const { scrollYProgress } = useScroll({
    target: sectionRef,
    offset: ["start start", "end end"],
  });

  useMotionValueEvent(scrollYProgress, "change", (latest) => {
    const nextStep = getStepIndex(latest);
    setActiveStep((current) => (current === nextStep ? current : nextStep));
  });

  const headingY = useTransform(scrollYProgress, [0.04, 0.24], [72, 0]);
  const headingOpacity = useTransform(scrollYProgress, [0.02, 0.16], [0.2, 1]);
  const lineTwoY = useTransform(scrollYProgress, [0.08, 0.28], [94, 0]);
  const introCopyY = useTransform(scrollYProgress, [0.18, 0.4], [30, 0]);
  const introCopyOpacity = useTransform(scrollYProgress, [0.16, 0.32], [0, 1]);
  const panelY = useTransform(scrollYProgress, [0.14, 0.34], [68, 0]);
  const panelOpacity = useTransform(scrollYProgress, [0.12, 0.28], [0.1, 1]);
  const ctaY = useTransform(scrollYProgress, [0.34, 0.58], [28, 0]);
  const ctaOpacity = useTransform(scrollYProgress, [0.3, 0.46], [0, 1]);
  const progressScale = useTransform(scrollYProgress, [0.04, 0.92], [0, 1]);

  const activeSlide = RITUAL_SLIDES[activeStep];

  return (
    <section
      ref={sectionRef}
      className="relative hidden h-[260vh] bg-[var(--mie-washi)] text-[var(--mie-ink)] lg:block"
      aria-labelledby="slow-down-heading"
    >
      <div className="sticky top-0 h-[100svh] overflow-hidden">
        <div className="pointer-events-none absolute inset-0">
          <div className="absolute inset-x-0 top-0 h-px bg-[var(--mie-ink)]/8" />
          <div className="absolute -left-20 top-24 h-72 w-72 rounded-full bg-[var(--mie-matcha)]/16 blur-3xl" />
          <div className="absolute right-0 top-16 h-80 w-80 rounded-full bg-[var(--mie-moss)]/6 blur-3xl" />
          <div className="absolute bottom-[-6rem] left-1/3 h-64 w-64 rounded-full bg-[var(--mie-matcha-deep)]/6 blur-3xl" />
        </div>

        <div className="relative mx-auto flex h-full max-w-[1520px] flex-col px-8 py-4 xl:px-12 xl:py-5">
          <div className="flex shrink-0 items-center justify-between border-b border-[var(--mie-ink)]/10 pb-3">
            <div className="flex items-center gap-4">
              <div className="grid size-11 place-items-center rounded-full border border-[var(--mie-ink)]/12 bg-white/26 text-[10px] font-bold tracking-[0.12em] text-[var(--mie-ink)]/78">
                01
              </div>
              <div>
                <p className="text-[10px] font-bold uppercase tracking-[0.28em] text-[var(--mie-moss)]/78">
                  MIE philosophy
                </p>
                <p className="mt-1 text-sm text-[var(--mie-ink)]/54">
                  Chậm hơn để cảm trà rõ hơn.
                </p>
              </div>
            </div>

            <div className="flex items-center gap-4">
              <span className="text-[10px] font-semibold uppercase tracking-[0.24em] text-[var(--mie-ink)]/40">
                Scroll to move the scene
              </span>
              <div className="h-px w-28 overflow-hidden bg-[var(--mie-ink)]/10">
                <motion.div
                  className="mie-slide-motion h-full origin-left bg-[var(--mie-matcha-deep)]"
                  style={{ scaleX: progressScale }}
                />
              </div>
            </div>
          </div>

          <div className="grid min-h-0 flex-1 items-center gap-8 py-3 lg:grid-cols-[1.02fr_0.98fr] lg:gap-10 lg:py-4 xl:gap-14">
            <motion.div
              className="mie-slide-motion min-w-0"
              style={{ y: headingY, opacity: headingOpacity }}
            >
              <p className="mb-5 text-[10px] font-bold uppercase tracking-[0.3em] text-[var(--mie-moss)]/58">
                Japanese tea · Tây Ninh
              </p>

              <h2
                id="slow-down-heading"
                className="max-w-[8ch] font-serif text-[clamp(3.55rem,7.2vw,7.2rem)] leading-[0.84] tracking-[-0.058em] xl:text-[clamp(4rem,7.4vw,7.5rem)]"
              >
                <span className="block overflow-hidden">
                  <motion.span
                    className="mie-slide-motion block"
                    style={{ y: headingY }}
                  >
                    Slow down.
                  </motion.span>
                </span>

                <span className="mt-2 block overflow-hidden">
                  <motion.span
                    className="mie-slide-motion block"
                    style={{ y: lineTwoY }}
                  >
                    with{" "}
                    <em className="italic text-[var(--mie-matcha-deep)]">
                      MIE.
                    </em>
                  </motion.span>
                </span>
              </h2>

              <motion.p
                className="mie-slide-motion mt-6 max-w-xl text-[1.02rem] leading-8 text-[var(--mie-ink)]/68 xl:mt-8 xl:text-lg xl:leading-9"
                style={{ y: introCopyY, opacity: introCopyOpacity }}
              >
                Một phần matcha ngon không chỉ nằm ở chất lượng trà, mà còn ở
                cách bạn bước chậm lại — chọn vị, nhìn màu xanh mở ra và ở cùng
                chiếc cốc thêm một nhịp.
              </motion.p>

              <motion.div
                className="mie-slide-motion mt-6 flex flex-wrap items-center gap-3 xl:mt-8"
                style={{ y: ctaY, opacity: ctaOpacity }}
              >
                <Link
                  href="/visit"
                  className="group inline-flex min-h-12 items-center justify-center gap-3 rounded-full border border-[#29452c] bg-[#17351b] px-6 py-3 !text-[#fffaf0] shadow-[0_14px_34px_rgba(20,34,18,0.22)] transition-[transform,box-shadow,background-color] duration-200 hover:-translate-y-0.5 hover:bg-[#214a25]"
                >
                  <span className="grid size-7 place-items-center rounded-full border border-white/15 bg-white/10 text-[#fffaf0]">
                    <VisitIcon />
                  </span>
                  <span className="text-[10px] font-extrabold uppercase tracking-[0.22em] text-[#fffaf0]">
                    Visit MIE
                  </span>
                </Link>

                <Link
                  href="/about"
                  className="group inline-flex min-h-12 items-center justify-center gap-3 rounded-full border border-[#172314]/16 bg-[#fffaf0] px-6 py-3 text-[#172314] shadow-[0_10px_24px_rgba(32,43,28,0.07)] transition-[transform,box-shadow,background-color,border-color] duration-200 hover:-translate-y-0.5"
                >
                  <span className="grid size-7 place-items-center rounded-full border border-[#172314]/10 bg-[#edf0df]">
                    <StoryIcon />
                  </span>
                  <span className="text-[10px] font-extrabold uppercase tracking-[0.22em]">
                    Our story
                  </span>
                </Link>

                <span className="inline-flex min-h-11 items-center gap-2 rounded-full border border-[#172314]/10 bg-white/24 px-4 text-[#52604d]">
                  <span className="text-[9px] font-bold uppercase tracking-[0.18em]">
                    Cuộn để đổi bước
                  </span>
                  <span aria-hidden="true" className="h-1 w-1 rounded-full bg-[#7d914e]" />
                  <span className="text-[9px] font-extrabold uppercase tracking-[0.18em] text-[#6e8345]">
                    {activeSlide.title}
                  </span>
                </span>
              </motion.div>
            </motion.div>

            <motion.div
              className="mie-slide-motion relative min-h-0"
              style={{ y: panelY, opacity: panelOpacity }}
            >
              <div className="absolute -inset-5 rounded-[2.25rem] bg-[radial-gradient(circle_at_top_left,rgba(200,220,122,0.14),transparent_42%)] blur-2xl" />

              <div className="relative max-h-[calc(100svh-7.25rem)] overflow-hidden rounded-[2rem] border border-[var(--mie-ink)]/10 bg-[var(--mie-ivory)]/78 shadow-[0_24px_72px_rgba(32,43,28,0.1)] backdrop-blur-md">
                <div className="border-b border-[var(--mie-ink)]/8 px-5 py-4">
                  <div className="flex flex-wrap items-center justify-between gap-4">
                    <div>
                      <p className="text-[10px] font-bold uppercase tracking-[0.26em] text-[var(--mie-moss)]/56">
                        The MIE ritual
                      </p>
                      <h3 className="mt-1.5 font-serif text-[1.75rem] leading-tight tracking-[-0.03em] xl:text-[1.9rem]">
                        Three steps. One quiet cup.
                      </h3>
                    </div>

                    <div className="rounded-full border border-[var(--mie-matcha-deep)]/18 bg-[var(--mie-matcha)]/14 px-4 py-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--mie-matcha-deep)]">
                      {activeSlide.id} / 03
                    </div>
                  </div>
                </div>

                <div className="grid min-h-0 gap-3 p-4 lg:grid-cols-[9.5rem_minmax(0,1fr)] lg:gap-4 lg:p-4 xl:grid-cols-[10.5rem_minmax(0,1fr)]">
                  <div className="grid gap-3">
                    {RITUAL_SLIDES.map((slide, index) => {
                      const active = index === activeStep;

                      return (
                        <div
                          key={slide.id}
                          className={[
                            "rounded-[1.1rem] border px-3.5 py-3 transition-all duration-300",
                            active
                              ? "border-[var(--mie-matcha-deep)]/20 bg-[var(--mie-matcha)]/18 shadow-[0_12px_34px_rgba(125,145,78,0.12)]"
                              : "border-[var(--mie-ink)]/8 bg-white/36",
                          ].join(" ")}
                        >
                          <p className="text-[9px] font-bold uppercase tracking-[0.22em] text-[var(--mie-matcha-deep)]/84">
                            {slide.id}
                          </p>
                          <p className="mt-1.5 font-serif text-[1.35rem] leading-none tracking-[-0.03em] xl:text-2xl">
                            {slide.title}
                          </p>
                          <p className="mt-1.5 text-[9px] font-semibold uppercase leading-4 tracking-[0.16em] text-[var(--mie-ink)]/42">
                            {slide.accent}
                          </p>
                        </div>
                      );
                    })}
                  </div>

                  <div className="relative h-[21rem] min-h-0 overflow-hidden rounded-[1.4rem] border border-[var(--mie-ink)]/8 bg-white/42 p-4 xl:h-[22rem] xl:p-5">
                    <div className="absolute inset-x-0 top-0 h-1 bg-[var(--mie-ink)]/5">
                      <motion.div
                        className="mie-slide-motion h-full origin-left bg-[var(--mie-matcha-deep)]"
                        style={{ scaleX: progressScale }}
                      />
                    </div>

                    <AnimatePresence mode="wait">
                      <motion.div
                        key={activeSlide.id}
                        initial={{ opacity: 0, y: 58 }}
                        animate={{
                          opacity: 1,
                          y: 0,
                          transition: {
                            duration: 0.55,
                            ease: [0.22, 1, 0.36, 1],
                          },
                        }}
                        exit={{
                          opacity: 0,
                          y: -40,
                          transition: {
                            duration: 0.28,
                            ease: "easeOut",
                          },
                        }}
                        className="mie-slide-motion flex h-full min-h-0 flex-col justify-between"
                      >
                        <div>
                          <p className="text-[10px] font-bold uppercase tracking-[0.24em] text-[var(--mie-moss)]/55">
                            {activeSlide.eyebrow}
                          </p>

                          <div className="mt-3 flex flex-wrap items-end gap-3">
                            <span className="font-serif text-5xl leading-none tracking-[-0.06em] xl:text-6xl">
                              {activeSlide.id}
                            </span>
                            <div className="pb-2">
                              <h4 className="font-serif text-[2rem] leading-none tracking-[-0.04em] xl:text-4xl">
                                {activeSlide.title}
                              </h4>
                              <p className="mt-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--mie-matcha-deep)]">
                                {activeSlide.accent}
                              </p>
                            </div>
                          </div>

                          <p className="mt-5 max-w-[40ch] text-[0.95rem] leading-7 text-[var(--mie-ink)]/68 xl:mt-6 xl:text-base xl:leading-8">
                            {activeSlide.copy}
                          </p>
                        </div>

                        <div className="mt-4 rounded-[1.1rem] border border-[var(--mie-ink)]/8 bg-[var(--mie-washi)]/84 px-4 py-3 xl:mt-5 xl:py-4">
                          <p className="text-[9px] font-bold uppercase tracking-[0.22em] text-[var(--mie-moss)]/42">
                            Why this matters
                          </p>
                          <p className="mt-1.5 font-serif text-[1.05rem] italic leading-6 tracking-[-0.02em] text-[var(--mie-matcha-deep)] xl:text-xl">
                            {activeSlide.note}
                          </p>
                        </div>
                      </motion.div>
                    </AnimatePresence>
                  </div>
                </div>

                <div className="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--mie-ink)]/8 px-5 py-3">
                  <p className="text-[9px] font-bold uppercase tracking-[0.22em] text-[var(--mie-moss)]/42">
                    MIE MATCHA · TÂY NINH
                  </p>
                  <p className="text-[10px] text-[var(--mie-ink)]/44">
                    Cuộn để card đổi như một slide trình chiếu.
                  </p>
                </div>
              </div>
            </motion.div>
          </div>

          <div className="flex shrink-0 items-center justify-between border-t border-[var(--mie-ink)]/10 pt-3">
            <p className="text-[10px] font-semibold uppercase tracking-[0.2em] text-[var(--mie-ink)]/34">
              Presentation-style scroll · clear CTA
            </p>

            <div className="flex items-center gap-3">
              {RITUAL_SLIDES.map((slide, index) => (
                <span
                  key={slide.id}
                  className={[
                    "h-1.5 rounded-full transition-all duration-300",
                    index === activeStep
                      ? "w-10 bg-[var(--mie-matcha-deep)]"
                      : "w-4 bg-[var(--mie-ink)]/12",
                  ].join(" ")}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}

export function SlowDownScene() {
  return (
    <>
      <MobileSlowDownScene />
      <DesktopSlowDownScene />
    </>
  );
}
