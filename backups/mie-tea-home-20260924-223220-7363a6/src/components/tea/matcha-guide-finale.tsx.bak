"use client";

import Link from "next/link";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { useGSAP } from "@gsap/react";
import { useRef } from "react";

gsap.registerPlugin(ScrollTrigger, useGSAP);

const TASTE_AXES = [
  {
    number: "01",
    title: "Body",
    caption: "Cảm giác đầu tiên",
    copy: "Độ dày và độ đậm của matcha khi ở trong miệng.",
    cue: "light → dense",
  },
  {
    number: "02",
    title: "Umami",
    caption: "Chiều sâu vị",
    copy: "Độ ngọt-mặn đặc trưng tạo cảm giác tròn và dày vị.",
    cue: "soft → deep",
  },
  {
    number: "03",
    title: "Floral",
    caption: "Hương thơm",
    copy: "Nhóm hương hoa, cỏ non và những nốt thơm sáng.",
    cue: "quiet → aromatic",
  },
  {
    number: "04",
    title: "Creamy",
    caption: "Texture",
    copy: "Cảm giác béo, bùi và mượt trên vòm miệng.",
    cue: "clean → creamy",
  },
] as const;

function AxisSignal({ index }: { index: number }) {
  return (
    <div
      className="mt-6 flex items-center gap-1.5"
      aria-hidden="true"
    >
      {Array.from({ length: 5 }).map((_, dotIndex) => (
        <span
          key={dotIndex}
          className={[
            "h-1.5 rounded-full transition-all duration-300",
            dotIndex <= index
              ? "w-5 bg-[#71854b]"
              : "w-2.5 bg-[#17351b]/12",
          ].join(" ")}
        />
      ))}
    </div>
  );
}

export function MatchaGuideFinale() {
  const sectionRef = useRef<HTMLElement | null>(null);

  useGSAP(
    () => {
      const mm = gsap.matchMedia();

      mm.add(
        "(min-width: 1024px) and (prefers-reduced-motion: no-preference)",
        () => {
          gsap.set(".guide-eyebrow, .guide-heading, .guide-copy, .guide-meta", {
            y: 42,
            autoAlpha: 0,
          });

          gsap.set(".guide-axis-card", {
            y: 72,
            autoAlpha: 0,
            rotateX: 8,
            transformPerspective: 900,
            transformOrigin: "50% 100%",
          });

          gsap.set(".guide-cta", {
            y: 36,
            autoAlpha: 0,
          });

          const tl = gsap.timeline({
            defaults: { ease: "power3.out" },
            scrollTrigger: {
              trigger: sectionRef.current,
              start: "top top",
              end: "bottom bottom",
              scrub: 0.8,
              invalidateOnRefresh: true,
            },
          });

          tl.to(".guide-eyebrow", {
            y: 0,
            autoAlpha: 1,
            duration: 0.12,
          })
            .to(
              ".guide-heading",
              {
                y: 0,
                autoAlpha: 1,
                duration: 0.2,
              },
              0.04,
            )
            .to(
              ".guide-copy",
              {
                y: 0,
                autoAlpha: 1,
                duration: 0.16,
              },
              0.1,
            )
            .to(
              ".guide-meta",
              {
                y: 0,
                autoAlpha: 1,
                duration: 0.14,
              },
              0.14,
            )
            .to(
              ".guide-axis-card",
              {
                y: 0,
                autoAlpha: 1,
                rotateX: 0,
                stagger: 0.065,
                duration: 0.22,
              },
              0.18,
            )
            .to(
              ".guide-axis-card:nth-child(1)",
              {
                y: -6,
                duration: 0.08,
              },
              0.45,
            )
            .to(
              ".guide-axis-card:nth-child(2)",
              {
                y: -6,
                duration: 0.08,
              },
              0.51,
            )
            .to(
              ".guide-axis-card:nth-child(3)",
              {
                y: -6,
                duration: 0.08,
              },
              0.57,
            )
            .to(
              ".guide-axis-card:nth-child(4)",
              {
                y: -6,
                duration: 0.08,
              },
              0.63,
            )
            .to(
              ".guide-cta",
              {
                y: 0,
                autoAlpha: 1,
                duration: 0.2,
              },
              0.7,
            );
        },
      );

      mm.add(
        "(max-width: 1023px) and (prefers-reduced-motion: no-preference)",
        () => {
          gsap.from(
            ".guide-eyebrow, .guide-heading, .guide-copy, .guide-meta, .guide-axis-card, .guide-cta",
            {
              y: 26,
              autoAlpha: 0,
              stagger: 0.055,
              duration: 0.55,
              ease: "power2.out",
              scrollTrigger: {
                trigger: sectionRef.current,
                start: "top 84%",
                once: true,
              },
            },
          );
        },
      );

      mm.add("(prefers-reduced-motion: reduce)", () => {
        gsap.set(
          ".guide-eyebrow, .guide-heading, .guide-copy, .guide-meta, .guide-axis-card, .guide-cta",
          {
            clearProps: "all",
          },
        );
      });

      return () => mm.revert();
    },
    { scope: sectionRef },
  );

  return (
    <section
      ref={sectionRef}
      aria-labelledby="matcha-guide-title"
      className="relative bg-[#f6f1e6] text-[#17351b] lg:h-[175vh]"
    >
      <div className="lg:sticky lg:top-0 lg:flex lg:min-h-screen lg:items-center">
        <div className="mx-auto w-full max-w-[1320px] px-5 py-16 sm:px-8 lg:px-12 lg:py-16">
          <div className="mb-8 flex items-center justify-between border-b border-[#17351b]/10 pb-4">
            <p className="guide-eyebrow text-[10px] font-semibold uppercase tracking-[0.24em] text-[#71854b]">
              How to read matcha
            </p>

            <div className="guide-meta hidden items-center gap-3 sm:flex">
              <span className="text-[9px] font-semibold uppercase tracking-[0.18em] text-[#17351b]/44">
                4 taste axes
              </span>
              <span className="h-px w-14 bg-[#17351b]/12" />
              <span className="text-[9px] font-semibold uppercase tracking-[0.18em] text-[#17351b]/44">
                read · compare · taste
              </span>
            </div>
          </div>

          <div className="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-14">
            <div className="lg:pr-3">
              <h2
                id="matcha-guide-title"
                className="guide-heading max-w-[8.7ch] font-sans text-[clamp(3.4rem,5.2vw,5.7rem)] font-semibold leading-[0.93] tracking-[-0.045em]"
              >
                Đọc matcha
                <span className="block text-[#17351b]/42">
                  dễ hơn
                </span>
                <span className="block">
                  một chút.
                </span>
              </h2>

              <p className="guide-copy mt-7 max-w-[32rem] text-[1.05rem] leading-8 text-[#17351b]/68">
                Thay vì nhớ thật nhiều tasting notes, hãy bắt đầu bằng bốn câu hỏi:
                trà dày đến đâu, umami sâu đến đâu, hương thơm theo hướng nào và
                texture có mượt hay không.
              </p>

              <div className="guide-meta mt-8 grid max-w-[31rem] grid-cols-2 gap-px overflow-hidden rounded-[1.35rem] border border-[#17351b]/10 bg-[#17351b]/10">
                <div className="bg-[#fffaf0]/58 p-4">
                  <p className="text-[9px] font-semibold uppercase tracking-[0.18em] text-[#17351b]/42">
                    Start here
                  </p>
                  <p className="mt-2 font-serif text-xl">
                    Cảm giác trước
                  </p>
                </div>

                <div className="bg-[#fffaf0]/58 p-4">
                  <p className="text-[9px] font-semibold uppercase tracking-[0.18em] text-[#17351b]/42">
                    Then notice
                  </p>
                  <p className="mt-2 font-serif text-xl">
                    Hậu vị sau
                  </p>
                </div>
              </div>
            </div>

            <div className="grid gap-4 sm:grid-cols-2">
              {TASTE_AXES.map((axis, index) => (
                <article
                  key={axis.number}
                  className="guide-axis-card group relative overflow-hidden rounded-[1.6rem] border border-[#17351b]/10 bg-[#fffaf0]/64 p-6 shadow-[0_10px_34px_rgba(23,53,27,0.055)] transition-[transform,box-shadow,background-color] duration-300 hover:-translate-y-1.5 hover:bg-[#fffaf0] hover:shadow-[0_18px_44px_rgba(23,53,27,0.09)] sm:p-7"
                >
                  <div
                    aria-hidden="true"
                    className="absolute right-0 top-0 size-28 translate-x-10 -translate-y-10 rounded-full bg-[#8aa259]/8 transition-transform duration-500 group-hover:scale-125"
                  />

                  <div className="relative flex items-start justify-between gap-5">
                    <div>
                      <p className="text-[10px] font-semibold tracking-[0.18em] text-[#71854b]">
                        {axis.number}
                      </p>

                      <p className="mt-5 text-[9px] font-semibold uppercase tracking-[0.18em] text-[#17351b]/42">
                        {axis.caption}
                      </p>

                      <h3 className="mt-2 font-serif text-[2.35rem] leading-none tracking-[-0.025em]">
                        {axis.title}
                      </h3>
                    </div>

                    <span
                      aria-hidden="true"
                      className="mt-1 grid size-9 place-items-center rounded-full border border-[#17351b]/10 text-sm text-[#17351b]/48 transition-transform duration-300 group-hover:rotate-45"
                    >
                      ↗
                    </span>
                  </div>

                  <p className="relative mt-5 max-w-[30ch] text-[1rem] leading-7 text-[#17351b]/68">
                    {axis.copy}
                  </p>

                  <AxisSignal index={index} />

                  <div className="relative mt-5 flex items-center justify-between border-t border-[#17351b]/8 pt-4">
                    <span className="text-[9px] font-semibold uppercase tracking-[0.16em] text-[#17351b]/36">
                      {axis.cue}
                    </span>

                    <span className="size-1.5 rounded-full bg-[#71854b]/70" />
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div className="guide-cta mt-9 rounded-[1.6rem] border border-[#17351b]/10 bg-[#17351b] p-6 text-[#fffaf0] shadow-[0_22px_60px_rgba(23,53,27,0.16)] sm:p-7">
            <div className="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
              <div className="max-w-[46rem]">
                <p className="text-[9px] font-semibold uppercase tracking-[0.22em] text-[#d3f08b]">
                  MIE MATCHA · Tây Ninh
                </p>

                <h3 className="mt-3 font-sans text-[clamp(1.6rem,2.5vw,2.45rem)] font-semibold leading-[1.1] tracking-[-0.03em]">
                  Chưa biết profile nào hợp khẩu vị của bạn?
                </h3>

                <p className="mt-2 text-sm leading-7 text-white/72">
                  Ghé MIE, tụi mình sẽ giúp bạn đọc vị và chọn một chén dễ bắt đầu hơn.
                </p>
              </div>

              <Link
                href="/visit"
                className="group inline-flex min-h-14 shrink-0 items-center justify-between gap-4 rounded-full bg-[#d3f08b] px-5 py-3 text-[#17351b] shadow-[0_12px_28px_rgba(0,0,0,0.16)] transition-[transform,box-shadow,background-color] duration-200 hover:-translate-y-1 hover:bg-[#e2f7a8] hover:shadow-[0_18px_36px_rgba(0,0,0,0.2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#d3f08b] focus-visible:ring-offset-2 focus-visible:ring-offset-[#17351b]"
              >
                <span style={{ color: "#111111" }} className="text-[10px] font-extrabold uppercase tracking-[0.18em] !text-[#111111]">
                  Visit MIE
                </span>

                <span
                  aria-hidden="true"
                  className="grid size-9 place-items-center rounded-full bg-[#17351b] text-[#f6f1e6] transition-transform duration-200 group-hover:translate-x-1"
                >
                  →
                </span>
              </Link>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}
