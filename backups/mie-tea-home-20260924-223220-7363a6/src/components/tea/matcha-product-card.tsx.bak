import Image from "next/image";
import Link from "next/link";

import type { MatchaProduct, TeaHouse } from "@/data/matcha-catalog";

type MatchaProductCardProps = {
  house: TeaHouse;
  product: MatchaProduct;
  priority?: boolean;
  tone?: "light" | "dark";
};

export function MatchaProductCard({
  house,
  product,
  priority = false,
  tone = "light",
}: MatchaProductCardProps) {
  const isLight = tone === "light";

  const shell = isLight
    ? "border-[#17351b]/10 bg-[#fffaf0] text-[#17351b] shadow-[0_18px_48px_rgba(23,53,27,0.08)] hover:border-[#17351b]/16 hover:shadow-[0_24px_64px_rgba(23,53,27,0.12)]"
    : "border-white/12 bg-[#17351b] text-[#fffaf0] shadow-[0_18px_48px_rgba(7,18,9,0.18)] hover:border-[#d3f08b]/18 hover:bg-[#1b4020]";

  const titleTone = isLight ? "text-[#17351b]" : "text-[#fffaf0]";
  const muted = isLight ? "text-[#17351b]/82" : "text-white/84";
  const subtle = isLight ? "text-[#17351b]/48" : "text-white/56";
  const accent = isLight ? "text-[#7d9350]" : "text-[#d3f08b]";
  const chip = isLight
    ? "border-[#17351b]/12 bg-[#f7f2e8] text-[#17351b]/72"
    : "border-white/12 bg-white/[0.05] text-white/84";

  return (
    <Link
      href={`/tea-houses/${house.slug}/${product.slug}`}
      className={[
        "group block h-full overflow-hidden rounded-[1.9rem] border transition-[transform,box-shadow,border-color,background-color] duration-300 hover:-translate-y-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#8ba555] focus-visible:ring-offset-4",
        isLight ? "focus-visible:ring-offset-[#f6f1e6]" : "focus-visible:ring-offset-[#17351b]",
        shell,
      ].join(" ")}
    >
      <div className="relative aspect-[4/3] overflow-hidden bg-[#eae7df]">
        <Image
          src={product.image}
          alt={`${product.name} — ${house.name}`}
          fill
          priority={priority}
          sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 40vw"
          className="object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
        />

        <div
          className={[
            "absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t to-transparent",
            isLight ? "from-[#17351b]/18" : "from-[#102612]/38",
          ].join(" ")}
        />

        <span
          className={[
            "absolute left-5 top-5 rounded-full border px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.18em] backdrop-blur-md",
            isLight
              ? "border-[#17351b]/10 bg-[#fffaf0]/92 text-[#17351b]/76"
              : "border-white/14 bg-[#17351b]/78 text-white/88",
          ].join(" ")}
        >
          View profile
        </span>
      </div>

      <div className="flex min-h-[21.5rem] flex-col p-6 sm:p-7">
        <div className="flex items-start justify-between gap-4">
          <div className="min-w-0">
            <p className={`text-[10px] font-semibold uppercase tracking-[0.22em] ${accent}`}>
              {house.name}
            </p>

            <h3
              className={`mt-3 font-serif text-[clamp(2rem,2.1vw,2.65rem)] leading-[1.02] tracking-[-0.02em] ${titleTone}`}
            >
              {product.name}
            </h3>
          </div>

          {product.japaneseName ? (
            <span className={`shrink-0 pt-2 text-lg ${subtle}`}>
              {product.japaneseName}
            </span>
          ) : null}
        </div>

        <p className={`mt-5 text-[1.05rem] leading-10 ${muted}`}>
          {product.summaryVi}
        </p>

        <div className="mt-6 flex flex-wrap gap-2.5">
          {product.notes.slice(0, 3).map((note) => (
            <span
              key={note}
              className={`rounded-full border px-3 py-1.5 text-[10px] font-medium uppercase tracking-[0.16em] ${chip}`}
            >
              {note}
            </span>
          ))}
        </div>

        <div
          className={[
            "mt-auto flex items-center justify-between border-t pt-6",
            isLight ? "border-[#17351b]/10" : "border-white/10",
          ].join(" ")}
        >
          <span className={`text-[10px] font-semibold uppercase tracking-[0.2em] ${subtle}`}>
            Read tasting guide
          </span>

          <span className={`text-xl transition-transform duration-300 group-hover:translate-x-1 ${accent}`}>
            →
          </span>
        </div>
      </div>
    </Link>
  );
}
