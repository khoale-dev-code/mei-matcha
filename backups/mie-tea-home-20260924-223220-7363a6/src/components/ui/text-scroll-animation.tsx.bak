                className="object-cover"
              />
              <figcaption className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 font-serif text-2xl">
                {image.label}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    </>
  );
}

export function MieTextScrollAnimation() {
  const targetRef2 = useRef<HTMLDivElement | null>(null);
  const targetRef3 = useRef<HTMLDivElement | null>(null);

  const { scrollYProgress: scrollYProgress2 } = useScroll({
    target: targetRef2,
    offset: ["start start", "end end"],
  });

  const { scrollYProgress: scrollYProgress3 } = useScroll({
    target: targetRef3,
    offset: ["start start", "end end"],
  });

  const closingText = "warm toasted quiet";
  const closingCharacters = closingText.split("");
  const closingCenter = Math.floor(closingCharacters.length / 2);
  const teaCenter = Math.floor(teaHouseImages.length / 2);
  const ritualCenter = Math.floor(ritualImages.length / 2);

  const teaTitleOpacity = useTransform(
    scrollYProgress2,
    [0.02, 0.14],
    [0.55, 1],
  );
  const teaTitleY = useTransform(scrollYProgress2, [0.02, 0.16], [16, 0]);
  const teaCopyOpacity = useTransform(
    scrollYProgress2,
    [0.32, 0.52],
    [0.45, 1],
  );
  const teaCopyY = useTransform(scrollYProgress2, [0.32, 0.52], [12, 0]);
  const closingCopyOpacity = useTransform(
    scrollYProgress3,
    [0.34, 0.55],
    [0.45, 1],
  );
  const closingCopyY = useTransform(scrollYProgress3, [0.34, 0.55], [14, 0]);

  return (
    <div className="w-full bg-[#f3eddc]">
      <SlowDownScene />

      <MobileTeaHouseSection />

      <section
        ref={targetRef2}
        className="relative hidden h-[185vh] bg-[#10200f] lg:block"
      >
        <div className="sticky top-0 flex h-[100svh] flex-col items-center justify-center gap-8 overflow-hidden px-10 text-[#f7f2e8]">
          <motion.div
            className="flex max-w-4xl items-center justify-center gap-3 text-center"
            style={{ opacity: teaTitleOpacity, y: teaTitleY }}
          >
            <Bracket className="h-12 shrink-0 text-[#c8da88]" />
            <div>
              <p className="text-[9px] font-semibold uppercase tracking-[0.24em] text-[#b8ca79]">
                Tea house selection
              </p>
              <h2 className="mt-2 font-serif text-[clamp(2.8rem,5vw,5.3rem)] leading-[0.92] tracking-[-0.045em] text-[#fffaf0]">
                Selected from Japan
              </h2>
            </div>
            <Bracket className="h-12 shrink-0 scale-x-[-1] text-[#c8da88]" />
          </motion.div>

          <div
            className="flex w-full max-w-[1450px] items-center justify-center gap-5"
            style={{ perspective: "800px" }}
          >
            {teaHouseImages.map((image, index) => (
              <CharacterV2
                key={image.src}
                src={image.src}
                alt={image.alt}
                label={image.label}
                index={index}
                centerIndex={teaCenter}
                scrollYProgress={scrollYProgress2}
              />
            ))}
          </div>

          <motion.div
            className="text-center"
            style={{ opacity: teaCopyOpacity, y: teaCopyY }}
          >
            <p className="mx-auto max-w-2xl text-sm leading-7 text-[#e1e7da]/78">
              Marukyu Koyamaen, Ishimoto, Shogyokuen, Atami và Waba — mỗi nhà
              trà mang một profile riêng để bạn khám phá.
            </p>

            <Link
              href="/tea-houses"
              className="mt-5 inline-flex min-h-12 items-center justify-center rounded-full border border-[#c8da88]/36 bg-[#c8da88]/10 px-6 text-[9px] font-bold uppercase tracking-[0.2em] text-[#e7f0bd] transition hover:bg-[#c8da88] hover:text-[#172314]"
            >
              Explore Tea Houses ↗
            </Link>
          </motion.div>
        </div>
      </section>

      <MobileHojichaSection />

      <section
        ref={targetRef3}
        className="relative hidden h-[185vh] bg-[#6f4827] lg:block"
      >
        <div className="sticky top-0 flex h-[100svh] flex-col items-center justify-center gap-7 overflow-hidden px-10 text-[#fff7ed]">
          <div
            className="max-w-[1500px] text-center font-serif text-[clamp(3.3rem,8.2vw,7.8rem)] leading-[0.9] tracking-[-0.052em] text-[#fff7ed]"
            style={{ perspective: "700px" }}
          >
            {closingCharacters.map((char, index) => (
              <CharacterV3
                key={`${char}-${index}`}
                char={char}
                index={index}
                centerIndex={closingCenter}
                scrollYProgress={scrollYProgress3}
                className={
                  index >= closingText.indexOf("toasted") &&
                  index < closingText.indexOf("quiet")
                    ? "italic text-[#f1d2aa]"
                    : undefined
                }
              />
            ))}
          </div>

          <div
            className="flex w-full max-w-[1400px] items-center justify-center gap-5"
            style={{ perspective: "800px" }}
          >
            {ritualImages.map((image, index) => (
              <CharacterV2
                key={`${image.src}-${index}`}
                src={image.src}
                alt={image.alt}
                label={image.label}
                index={index}
                centerIndex={ritualCenter}
                scrollYProgress={scrollYProgress3}
                variant="rotate"
              />
            ))}
          </div>

          <motion.div
            className="max-w-2xl text-center"
            style={{ opacity: closingCopyOpacity, y: closingCopyY }}
          >
            <p className="text-sm leading-7 text-[#f8e8d8]/90">
              Hojicha mang đến một nhịp thưởng trà êm hơn — ấm, rang nhẹ,
              thoảng hương gỗ và caramel. Vị trà tròn, dịu và ít đắng, phù hợp
              cho những khoảng nghỉ mềm hơn trong ngày.
            </p>

            <div className="mt-5 flex flex-wrap justify-center gap-3">
              <Link
                href="/tea-houses#hojicha"
                className="group inline-flex min-h-12 items-center justify-center rounded-full border border-[#fff4e2] bg-[#fff4e2] px-6 text-center text-[10px] font-extrabold uppercase tracking-[0.17em] !text-[#5b371a] shadow-[0_12px_30px_rgba(42,22,10,0.14)] transition-[transform,background-color,box-shadow] duration-300 hover:-translate-y-0.5 hover:bg-[#fff8ef] hover:shadow-[0_16px_36px_rgba(42,22,10,0.19)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#fff7ed]"
              >
                <span className="!text-[#5b371a]">Discover Hojicha ↗</span>
              </Link>

              <Link
                href="/visit"
                className="group inline-flex min-h-12 items-center justify-center rounded-full border border-[#fff4e2]/45 bg-[#4f301b]/38 px-6 text-center text-[10px] font-extrabold uppercase tracking-[0.17em] !text-[#fff7ed] backdrop-blur-sm transition-[transform,background-color,border-color] duration-300 hover:-translate-y-0.5 hover:border-[#fff7ed]/68 hover:bg-[#4f301b]/58 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#fff7ed]"
              >
                <span className="!text-[#fff7ed]">Visit MIE ↗</span>
              </Link>
            </div>
          </motion.div>
        </div>
      </section>
    </div>
  );
}

const Skiper31 = MieTextScrollAnimation;

export {
  CharacterV1,
  CharacterV2,
  CharacterV3,
  Skiper31,
};
