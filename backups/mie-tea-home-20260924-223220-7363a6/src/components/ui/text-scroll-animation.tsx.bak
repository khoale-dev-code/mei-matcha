"use client";

import Image from "next/image";
import Link from "next/link";
import {
  motion,
  useMotionValueEvent,
  useScroll,
  useTransform,
  type MotionValue,
} from "framer-motion";
import React, { useRef, useState } from "react";

import { SlowDownScene } from "@/components/home/slow-down-scene";
import { cn } from "@/lib/utils";

type CharacterProps = {
  char: string;
  index: number;
  centerIndex: number;
  scrollYProgress: MotionValue<number>;
  className?: string;
};

const CharacterV1 = ({
  char,
  index,
  centerIndex,
  scrollYProgress,
  className,
}: CharacterProps) => {
  const isSpace = char === " ";
  const distance = index - centerIndex;

  const x = useTransform(scrollYProgress, [0.05, 0.5], [distance * 44, 0]);
  const y = useTransform(
    scrollYProgress,
    [0.05, 0.5],
    [Math.abs(distance) * 4, 0],
  );
  const rotateX = useTransform(
    scrollYProgress,
    [0.05, 0.5],
    [distance * 6, 0],
  );
  const opacity = useTransform(scrollYProgress, [0.03, 0.18], [0.3, 1]);

  return (
    <motion.span
      className={cn(
        "inline-block will-change-transform",
        isSpace && "w-[0.28em]",
        className,
      )}
      style={{ x, y, rotateX, opacity, transformOrigin: "center" }}
    >
      {isSpace ? "\u00A0" : char}
    </motion.span>
  );
};

type ImageCharacterProps = {
  src: string;
  alt: string;
  label?: string;
  index: number;
  centerIndex: number;
  scrollYProgress: MotionValue<number>;
  variant?: "soft" | "rotate";
};

const CharacterV2 = ({
  src,
  alt,
  label,
  index,
  centerIndex,
  scrollYProgress,
  variant = "soft",
}: ImageCharacterProps) => {
  const distance = index - centerIndex;
  const x = useTransform(scrollYProgress, [0.06, 0.5], [distance * 58, 0]);
  const y = useTransform(
    scrollYProgress,
    [0.06, 0.5],
    [Math.abs(distance) * 30, 0],
  );
  const scale = useTransform(scrollYProgress, [0.06, 0.5], [0.8, 1]);
  const rotate = useTransform(
    scrollYProgress,
    [0.06, 0.5],
    [variant === "rotate" ? distance * 7 : distance * 1.5, 0],
  );
  const opacity = useTransform(scrollYProgress, [0.03, 0.17], [0.42, 1]);

  return (
    <motion.figure
      className="group relative aspect-[4/5] w-[clamp(7.5rem,13vw,12.5rem)] shrink-0 overflow-hidden rounded-[1.55rem] border border-white/16 bg-black/10 shadow-[0_26px_70px_rgba(0,0,0,0.22)] will-change-transform sm:rounded-[1.9rem]"
      style={{ x, y, scale, rotate, opacity, transformOrigin: "center" }}
    >
      <motion.img
        src={src}
        alt={alt}
        className="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]"
        draggable={false}
      />

      <div className="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/48 via-transparent to-transparent" />

      {label ? (
        <figcaption className="absolute inset-x-0 bottom-0 p-3 text-center text-[8px] font-semibold uppercase tracking-[0.14em] text-white/80 sm:p-4 sm:text-[9px]">
          {label}
        </figcaption>
      ) : null}
    </motion.figure>
  );
};

const CharacterV3 = ({
  char,
  index,
  centerIndex,
  scrollYProgress,
  className,
}: CharacterProps) => {
  const isSpace = char === " ";
  const distance = index - centerIndex;

  const x = useTransform(scrollYProgress, [0.06, 0.5], [distance * 58, 0]);
  const y = useTransform(
    scrollYProgress,
    [0.06, 0.5],
    [-Math.abs(distance) * 14, 0],
  );
  const rotate = useTransform(
    scrollYProgress,
    [0.06, 0.5],
    [distance * 2.4, 0],
  );
  const opacity = useTransform(scrollYProgress, [0.03, 0.18], [0.28, 1]);

  return (
    <motion.span
      className={cn(
        "inline-block will-change-transform",
        isSpace && "w-[0.28em]",
        className,
      )}
      style={{ x, y, rotate, opacity, transformOrigin: "center" }}
    >
      {isSpace ? "\u00A0" : char}
    </motion.span>
  );
};

