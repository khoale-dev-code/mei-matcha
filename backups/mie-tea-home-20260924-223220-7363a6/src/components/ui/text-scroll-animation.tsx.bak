            <Link
              href="/visit"
              className="group inline-flex min-h-11 items-center justify-center rounded-full border border-[#fff4e2]/42 bg-[#4f301b]/48 px-3 text-center text-[8px] font-extrabold uppercase tracking-[0.13em] !text-[#fff7ed] backdrop-blur-sm"
            >
              <span className="!text-[#fff7ed]">Visit MIE ↗</span>
