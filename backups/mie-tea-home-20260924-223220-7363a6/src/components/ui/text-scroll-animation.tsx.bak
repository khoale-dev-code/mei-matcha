  {
    src: "/images/marukyu.jpg",
    alt: "Marukyu Koyamaen matcha",
    label: "Marukyu",
  },
  {
    src: "/images/ishimoto.jpg",
    alt: "Ishimoto Kawaguchien matcha",
    label: "Ishimoto",
  },
  {
    src: "/images/izumi-no-shiro.jpg",
    alt: "Shogyokuen matcha",
    label: "Shogyokuen",
  },
  {
    src: "/images/seiyousha.jpg",
    alt: "Atami Tea Store matcha",
    label: "Atami",
  },
  {
    src: "/images/waba-hana.jpg",
    alt: "Waba Tea matcha",
    label: "Waba",
  },
] as const;

const ritualImages = [
  {
    src: "/images/mie-hero.jpg",
    alt: "MIE MATCHA ritual",
    label: "MIE",
  },
  {
    src: "/images/marukyu.jpg",
    alt: "Japanese matcha",
    label: "Matcha",
  },
  {
    src: "/images/hojicha.jpg",
    alt: "Hojicha at MIE MATCHA",
    label: "Hojicha",
  },
  {
    src: "/images/waba-hana.jpg",
    alt: "Waba Tea",
    label: "Waba",
  },
  {
    src: "/images/seiyousha.jpg",
    alt: "Seiyousha matcha",
    label: "Seiyousha",
  },
] as const;

function Bracket({ className }: { className?: string }) {
  return (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 27 78"
      className={className}
      aria-hidden="true"
    >
      <path
        fill="currentColor"
        d="M26.52 77.21h-5.75c-6.83 0-12.38-5.56-12.38-12.38V48.38C8.39 43.76 4.63 40 .01 40v-4c4.62 0 8.38-3.76 8.38-8.38V12.4C8.38 5.56 13.94 0 20.77 0h5.75v4h-5.75c-4.62 0-8.38 3.76-8.38 8.38V27.6c0 4.34-2.25 8.17-5.64 10.38 3.39 2.21 5.64 6.04 5.64 10.38v16.45c0 4.62 3.76 8.38 8.38 8.38h5.75v4.02Z"
      />
    </svg>
  );
}


function getRailIndex(progress: number, count: number) {
  const raw = Math.round(progress * (count - 1));
  return Math.max(0, Math.min(count - 1, raw));
}

function MobileScrollRail({
  images,
  tone,
  scrollYProgress,
  activeIndex,
}: {
  images: readonly {
    src: string;
    alt: string;
    label: string;
  }[];
  tone: "green" | "brown";
  scrollYProgress: MotionValue<number>;
  activeIndex: number;
}) {
  const x = useTransform(scrollYProgress, [0.08, 0.92], ["0%", "-72%"]);
  const y = useTransform(scrollYProgress, [0.04, 0.16], [18, 0]);
  const opacity = useTransform(scrollYProgress, [0.02, 0.12], [0.45, 1]);

  const border =
    tone === "green" ? "border-white/14" : "border-[#fff7ed]/18";
  const background =
    tone === "green" ? "bg-[#172817]" : "bg-[#4f301b]";

  return (
    <motion.div
      className="mie-mobile-scroll-motion relative w-full overflow-hidden"
      style={{ y, opacity }}
    >
      <motion.div
        className="mie-mobile-scroll-motion flex w-max gap-3 will-change-transform"
        style={{ x }}
      >
        {images.map((image, index) => {
          const active = index === activeIndex;

          return (
            <figure
              key={`${tone}-${image.src}-${image.label}`}
              className={cn(
                "relative aspect-[4/5] w-[68vw] min-w-[12.5rem] max-w-[17.5rem] shrink-0 overflow-hidden rounded-[1.45rem] border shadow-[0_18px_46px_rgba(0,0,0,0.16)] transition-[opacity,transform,border-color] duration-300",
                border,
                background,
                active
                  ? "scale-100 opacity-100"
                  : "scale-[0.965] opacity-65",
              )}
            >
              <Image
                src={image.src}
                alt={image.alt}
                fill
                sizes="(max-width: 639px) 68vw, (max-width: 1023px) 17.5rem, 18rem"
                className="object-cover"
                priority={index === 0}
              />
              <div className="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent" />

              <div className="absolute inset-x-0 top-0 flex items-center justify-between gap-3 p-3">
                <span className="rounded-full border border-white/14 bg-black/16 px-2.5 py-1 text-[7px] font-bold uppercase tracking-[0.14em] text-white/82 backdrop-blur-sm">
                  {String(index + 1).padStart(2, "0")} / {String(images.length).padStart(2, "0")}
                </span>
                <span
                  className={cn(
                    "size-2 rounded-full transition-colors duration-300",
                    active
                      ? tone === "green"
                        ? "bg-[#c8da88]"
                        : "bg-[#f1d2aa]"
                      : "bg-white/24",
                  )}
                />
              </div>

              <figcaption className="absolute inset-x-0 bottom-0 p-4">
                <p className="text-[8px] font-bold uppercase tracking-[0.15em] text-white/56">
                  Scroll chapter
                </p>
                <p className="mt-1 font-serif text-[1.45rem] leading-none tracking-[-0.03em] text-white">
                  {image.label}
                </p>
              </figcaption>
            </figure>
          );
        })}
      </motion.div>
    </motion.div>
  );
}

function MobileTeaHouseSection() {
  const sectionRef = useRef<HTMLElement | null>(null);
  const [activeIndex, setActiveIndex] = useState(0);

  const { scrollYProgress } = useScroll({
    target: sectionRef,
    offset: ["start start", "end end"],
  });

  useMotionValueEvent(scrollYProgress, "change", (latest) => {
    const next = getRailIndex(latest, teaHouseImages.length);
    setActiveIndex((current) => (current === next ? current : next));
  });

  const titleY = useTransform(scrollYProgress, [0.02, 0.15], [24, 0]);
  const titleOpacity = useTransform(
    scrollYProgress,
    [0.01, 0.12],
    [0.42, 1],
  );
  const progressScale = useTransform(scrollYProgress, [0.02, 0.96], [0, 1]);
  const activeImage = teaHouseImages[activeIndex];

  return (
    <>
      <section
        ref={sectionRef}
        className="relative h-[300svh] bg-[#10200f] text-[#f7f2e8] motion-reduce:hidden lg:hidden"
      >
        <div className="sticky top-0 flex h-[100svh] min-h-[32rem] flex-col overflow-hidden px-4 pb-3 pt-[4.75rem] sm:px-6 sm:pt-[5.25rem]">
          <div className="pointer-events-none absolute inset-0">
            <div className="absolute -left-28 top-16 size-64 rounded-full bg-[#c8da88]/8 blur-3xl" />
            <div className="absolute -right-28 bottom-12 size-72 rounded-full bg-white/5 blur-3xl" />
          </div>

          <motion.div
            className="mie-mobile-scroll-motion relative shrink-0"
            style={{ y: titleY, opacity: titleOpacity }}
          >
            <div className="flex items-center justify-between gap-3">
              <div className="flex min-w-0 items-center gap-2.5">
                <Bracket className="h-8 shrink-0 text-[#c8da88]" />
                <div className="min-w-0">
                  <p className="text-[8px] font-semibold uppercase tracking-[0.2em] text-[#b8ca79]">
                    Tea house selection
                  </p>
                  <h2 className="mt-1 max-w-[10ch] font-serif text-[clamp(2.4rem,12vw,3.45rem)] leading-[0.9] tracking-[-0.045em] text-[#fffaf0]">
                    Selected from Japan
                  </h2>
                </div>
              </div>

              <span className="shrink-0 rounded-full border border-[#c8da88]/22 bg-[#c8da88]/10 px-2.5 py-1.5 text-[8px] font-extrabold tracking-[0.12em] text-[#dce9a8]">
                {String(activeIndex + 1).padStart(2, "0")} / 05
              </span>
            </div>

            <div className="mt-3 h-px overflow-hidden bg-white/10">
              <motion.div
                className="mie-mobile-scroll-motion h-full origin-left bg-[#c8da88]"
                style={{ scaleX: progressScale }}
              />
            </div>
          </motion.div>

          <div className="relative mt-3 flex min-h-0 flex-1 items-center">
            <MobileScrollRail
              images={teaHouseImages}
              tone="green"
              scrollYProgress={scrollYProgress}
              activeIndex={activeIndex}
            />
          </div>

          <div className="relative mt-3 shrink-0 rounded-[1.1rem] border border-white/10 bg-white/[0.055] px-3.5 py-3 backdrop-blur-sm">
            <div className="flex items-center justify-between gap-3">
              <div className="min-w-0">
                <p className="text-[7px] font-bold uppercase tracking-[0.17em] text-[#b8ca79]/68">
                  Now viewing
                </p>
                <p className="mt-1 truncate font-serif text-[1.2rem] leading-none tracking-[-0.025em] text-[#fffaf0]">
                  {activeImage.label}
                </p>
              </div>

              <div className="flex shrink-0 items-center gap-1.5">
                {teaHouseImages.map((image, index) => (
                  <span
                    key={image.label}
                    className={[
                      "h-1.5 rounded-full transition-all duration-300",
                      index === activeIndex
                        ? "w-6 bg-[#c8da88]"
                        : "w-2 bg-white/14",
                    ].join(" ")}
                  />
                ))}
              </div>
            </div>
          </div>

          <div className="relative mt-2.5 grid shrink-0 grid-cols-[1fr_auto] items-center gap-3">
            <p className="text-[8px] leading-4 text-[#e1e7da]/58">
              Cuộn dọc để chuyển từng nhà trà như một slide trình chiếu.
            </p>

            <Link
              href="/tea-houses"
              className="inline-flex min-h-10 items-center justify-center rounded-full border border-[#c8da88]/30 bg-[#c8da88] px-4 text-[8px] font-extrabold uppercase tracking-[0.14em] !text-[#172314] shadow-[0_10px_24px_rgba(0,0,0,0.12)]"
            >
              Explore ↗
            </Link>
          </div>
        </div>
      </section>

      <section className="hidden bg-[#10200f] px-4 py-16 text-[#f7f2e8] motion-reduce:block lg:hidden">
        <p className="text-[8px] font-semibold uppercase tracking-[0.2em] text-[#b8ca79]">
          Tea house selection
        </p>
        <h2 className="mt-2 font-serif text-5xl leading-[0.9] tracking-[-0.04em]">
          Selected from Japan
        </h2>
        <div className="mt-7 grid gap-3">
          {teaHouseImages.map((image) => (
            <figure
              key={image.src}
              className="relative aspect-[4/3] overflow-hidden rounded-[1.3rem] border border-white/12"
            >
              <Image
                src={image.src}
                alt={image.alt}
                fill
                sizes="100vw"
                className="object-cover"
              />
              <figcaption className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 font-serif text-2xl">
                {image.label}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    </>
  );
}

function MobileHojichaSection() {
  const sectionRef = useRef<HTMLElement | null>(null);
  const [activeIndex, setActiveIndex] = useState(0);

  const { scrollYProgress } = useScroll({
    target: sectionRef,
    offset: ["start start", "end end"],
  });

  useMotionValueEvent(scrollYProgress, "change", (latest) => {
    const next = getRailIndex(latest, ritualImages.length);
    setActiveIndex((current) => (current === next ? current : next));
  });

  const headingY = useTransform(scrollYProgress, [0.02, 0.15], [24, 0]);
  const headingOpacity = useTransform(
    scrollYProgress,
    [0.01, 0.12],
    [0.42, 1],
  );
  const progressScale = useTransform(scrollYProgress, [0.02, 0.96], [0, 1]);
  const activeImage = ritualImages[activeIndex];

  return (
    <>
      <section
        ref={sectionRef}
        className="relative h-[300svh] bg-[#6f4827] text-[#fff7ed] motion-reduce:hidden lg:hidden"
      >
        <div className="sticky top-0 flex h-[100svh] min-h-[32rem] flex-col overflow-hidden px-4 pb-3 pt-[4.75rem] sm:px-6 sm:pt-[5.25rem]">
