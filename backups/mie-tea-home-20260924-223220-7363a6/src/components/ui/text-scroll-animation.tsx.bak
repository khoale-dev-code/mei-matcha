          Warm. <span className="italic text-[#f1d2aa]">Toasted.</span> Quiet.
        </h2>
        <div className="mt-7 grid gap-3">
          {ritualImages.map((image) => (
            <figure
              key={image.src}
              className="relative aspect-[4/3] overflow-hidden rounded-[1.3rem] border border-[#fff7ed]/16"
            >
              <Image
