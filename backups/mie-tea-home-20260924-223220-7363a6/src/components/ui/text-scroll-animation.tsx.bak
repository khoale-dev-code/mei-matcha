      <section className="hidden bg-[#6f4827] px-4 py-16 text-[#fff7ed] motion-reduce:block lg:hidden">
        <p className="text-[8px] font-semibold uppercase tracking-[0.2em] text-[#f1d2aa]/80">
          Beyond matcha · roasted tea
        </p>
