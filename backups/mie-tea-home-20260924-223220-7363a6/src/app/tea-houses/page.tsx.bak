                <div className="rounded-[1.6rem] border border-[#17351b]/10 bg-[#17351b] p-6 text-[#fffaf0] shadow-[0_18px_56px_rgba(10,23,11,0.18)]">
                  <p className="text-[10px] font-semibold uppercase tracking-[0.22em] text-[#d3f08b]">
