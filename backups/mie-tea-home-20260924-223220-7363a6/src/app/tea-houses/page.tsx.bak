                <div className="grid grid-cols-3 overflow-hidden rounded-[1.6rem] border border-[#17351b]/10 bg-white/55 shadow-[0_18px_56px_rgba(23,53,27,0.08)]">
                  <div className="p-5 sm:p-6">
                    <p className="font-serif text-4xl">{teaHouses.length}</p>
                    <p className="mt-2 text-[10px] uppercase tracking-[0.18em] text-[#17351b]/48">
                      Tea houses
