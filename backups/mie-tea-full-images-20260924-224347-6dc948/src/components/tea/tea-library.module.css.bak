/* Mobile: one column and a swipeable index. Tablet: two product columns.
   Desktop: a sticky index, short house introductions and up to three products per row. */
.library {
  --tea-ivory: #f7f8f1;
  --tea-washi: #e6e9db;
  --tea-moss: #233b2b;
  --tea-matcha: #7c9457;
  --tea-hojicha: #805637;
  --tea-muted: #52634d;
  --tea-line: #d4dccb;
  --tea-display: "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
  background: var(--tea-ivory);
  color: var(--tea-moss);
  font-family: "Aptos", "Segoe UI", Arial, sans-serif;
}
.container { width: min(100% - 40px, 1320px); margin-inline: auto; }
.hero { display: grid; gap: 32px; padding-block: 128px 48px; }
.heroCopy { align-self: center; }
.hero h1 { max-width: 13ch; margin: 0; font-size: clamp(2.9rem, 5.5vw, 5.5rem); font-weight: 550; line-height: 1.03; letter-spacing: -.055em; text-wrap: balance; }
.intro { max-width: 49ch; margin: 24px 0 0; font-size: clamp(1.0625rem, 1.4vw, 1.1875rem); line-height: 1.8; color: var(--tea-muted); }
.collectionCount { margin: 18px 0 0; font-size: .9375rem; line-height: 1.7; color: var(--tea-muted); }
.heroLinks { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.primary,
.secondary { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; max-width: 100%; padding: 12px 20px; border: 1px solid var(--tea-moss); border-radius: 999px; font-size: 1rem; font-weight: 600; line-height: 1.4; text-align: center; text-decoration: none; }
.primary { color: var(--tea-ivory); background: var(--tea-moss); }
.secondary { color: var(--tea-moss); background: transparent; border-color: var(--tea-line); }
.heroFigure { margin: 0; min-width: 0; }
.heroPhoto { position: relative; aspect-ratio: 6 / 5; overflow: hidden; border-radius: 50% 50% 16px 16px; background: var(--tea-washi); }
.heroPhoto img { object-fit: cover; }
.heroFigure figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; margin-top: 12px; font-size: .875rem; line-height: 1.6; color: var(--tea-muted); }
.indexWrap { background: var(--tea-ivory); border-block: 1px solid var(--tea-line); }
.indexInner { display: flex; align-items: center; gap: 20px; }
.indexLabel { display: none; flex: 0 0 auto; font-size: .875rem; font-weight: 600; }
.index { display: flex; flex: 1; min-width: 0; gap: 8px; padding-block: 12px; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: var(--tea-matcha) transparent; }
.index a { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; gap: 10px; min-height: 44px; padding: 9px 15px; border: 1px solid var(--tea-line); border-radius: 999px; background: white; color: var(--tea-moss); font-size: .875rem; font-weight: 550; text-decoration: none; white-space: nowrap; }
.index a span { color: var(--tea-muted); font-size: .75rem; }
.index a:last-child { border-color: #c7af97; color: #664327; background: #f0e7dc; }
.house { padding-block: clamp(44px, 6vw, 84px); border-bottom: 1px solid var(--tea-line); }
.houseHeading { display: grid; gap: 20px; margin-bottom: 28px; }
.houseHeading h2 { max-width: 22ch; margin: 0; font-size: clamp(2.1rem, 3.4vw, 3.3rem); font-weight: 550; letter-spacing: -.045em; line-height: 1.12; text-wrap: balance; overflow-wrap: anywhere; }
.region { margin: 0 0 12px; font-size: .875rem; color: var(--tea-muted); line-height: 1.5; }
.houseIntro { max-width: 66ch; margin: 0; font-size: 1.0625rem; line-height: 1.8; color: var(--tea-muted); }
.houseMeta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 14px 0 0; font-size: .875rem; color: var(--tea-muted); }
.houseMeta span + span { border-left: 1px solid var(--tea-line); padding-left: 12px; }
.products { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
.product { min-width: 0; }
.card { display: flex; height: 100%; flex-direction: column; color: var(--tea-moss); background: #fff; border: 1px solid var(--tea-line); border-radius: 14px; overflow: hidden; text-decoration: none; }
.productPhoto { position: relative; aspect-ratio: 4 / 3; background: #e9eddf; overflow: hidden; }
.productPhoto img { object-fit: cover; }
.productPhoto[data-packshot="true"] { background: #fff; }
.productPhoto[data-packshot="true"] img { object-fit: contain; padding: 16px; }
.productCopy { display: flex; flex: 1; flex-direction: column; gap: 16px; min-width: 0; padding: 22px; }
.productTitle { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
.productTitle h3 { margin: 0; font-family: var(--tea-display); font-size: clamp(1.75rem, 2.2vw, 2.1rem); font-weight: 400; line-height: 1.2; letter-spacing: -.025em; }
.japanese { color: var(--tea-muted); font-size: 1rem; }
.summary { margin: 0; font-size: 1rem; line-height: 1.75; color: #455841; }
.notes { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; list-style: none; }
.notes li { padding: 5px 10px; border-radius: 5px; background: #eef2e5; color: #4b603f; font-size: .8125rem; line-height: 1.5; }
.readProfile { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--tea-line); font-size: .9375rem; font-weight: 600; }
.roasted { padding-block: clamp(48px, 7vw, 92px); background: #eee7dc; color: #513820; }
.roastedInner { display: grid; align-items: center; gap: 30px; }
.roastedPhoto { position: relative; aspect-ratio: 5 / 4; overflow: hidden; border-radius: 16px; background: #d1bca4; }
.roastedPhoto img { object-fit: cover; }
.roastedCopy { min-width: 0; }
.roastedHeading { display: flex; flex-wrap: wrap; align-items: baseline; gap: 18px; }
.roasted h2 { margin: 0; font-size: clamp(2.75rem, 5vw, 4.5rem); font-weight: 550; letter-spacing: -.05em; line-height: 1.1; }
.roasted p { max-width: 55ch; margin: 20px 0; font-size: 1.0625rem; line-height: 1.8; }
.featuredTea { margin-top: 26px; padding-top: 24px; border-top: 1px solid #cdbba7; }
.featuredTea h3 { margin: 0; font-family: var(--tea-display); font-size: 1.6rem; font-weight: 400; line-height: 1.35; }
.roasted details { margin-block: 12px 22px; }
.roasted summary { display: flex; align-items: center; width: fit-content; min-height: 44px; font-size: .9375rem; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }
.roasted details p { font-size: 1rem; }
.guide { padding-block: clamp(52px, 7vw, 96px); }
.guideHeading { display: grid; gap: 18px; }
.guide h2 { max-width: 18ch; margin: 0; font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 550; letter-spacing: -.045em; line-height: 1.15; }
.guideIntro { max-width: 53ch; margin: 0; color: var(--tea-muted); font-size: 1.0625rem; line-height: 1.8; }
.guideTerms { display: grid; gap: 0 40px; margin: 32px 0 0; }
.guideTerm { padding-block: 22px; border-top: 1px solid var(--tea-line); }
.guideTerm dt { font-size: 1.15rem; font-weight: 650; }
.guideTerm dd { max-width: 50ch; margin: 8px 0 0; font-size: 1rem; line-height: 1.8; color: var(--tea-muted); }
.invitation { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; margin-top: 36px; padding: clamp(24px, 3vw, 40px); border-radius: 18px; background: #e0e8d2; }
.invitation h3 { margin: 0; font-size: 1.5rem; font-weight: 550; letter-spacing: -.025em; }
.invitation p { max-width: 54ch; margin: 10px 0 0; color: var(--tea-muted); font-size: 1rem; line-height: 1.75; }
.invitationActions { display: flex; flex-wrap: wrap; gap: 10px; }
.library a:focus-visible,
.library summary:focus-visible { outline: 3px solid #597745; outline-offset: 4px; }

@media (min-width: 640px) {
  .container { width: min(100% - 64px, 1320px); }
  .products { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .guideTerms { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .products[data-single="true"] { grid-template-columns: minmax(0, 1fr); }
  .products[data-single="true"] .card { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); }
  .products[data-single="true"] .productPhoto { height: 100%; min-height: 300px; aspect-ratio: auto; }
}
@media (min-width: 900px) {
  .hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); align-items: center; gap: 48px; padding-block: 140px 64px; }
  .indexWrap { position: sticky; top: 100px; z-index: 20; }
  .house,
  .roasted,
  .guide { scroll-margin-top: 5rem; }
  .houseHeading { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); align-items: start; gap: 56px; margin-bottom: 34px; }
  .roastedInner { grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 56px; }
  .roastedPhoto { aspect-ratio: 4 / 5; }
  .guideHeading { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 56px; }
}
@media (min-width: 1200px) {
  .products { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .products[data-pair="true"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .indexLabel { display: inline; }
}
@media (hover: hover) {
  .index a:hover { border-color: var(--tea-matcha); background: var(--tea-washi); }
  .card:hover { border-color: var(--tea-matcha); }
  .card:hover .readProfile { text-decoration: underline; text-underline-offset: 4px; }
  .primary:hover { background: #365337; }
  .secondary:hover { background: var(--tea-washi); }
}
@media (prefers-reduced-motion: reduce) {
  .index { scroll-behavior: auto; }
}
